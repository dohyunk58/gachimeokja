// ------
// 가치먹자
// ------

Table users {
  id bigint [pk, increment]
  socialId varchar(100) [unique, not null]
  fullName varchar(100) [not null]
  email varchar(100) [unique, not null]
  phoneNumber varchar(11) [unique, not null]
  birthDate date [not null]
  authImgUrl varchar(255) [not null]
  nickname varchar(50) [unique, not null]
  createAt datetime [not null]
  updateAt datetime [not null]
  currentPoint int [not null]
}

Table restaurants {
  restaurant_id bigint [pk, increment]
  restaurant_name varchar [not null]
  restaurant_address varchar [not null]
  restaurant_phone varchar [not null]
  business_hours varchar
  delivery_fee int
  min_order_amount int
  payment_methods varchar
  restaurant_description varchar
  restaurant_category varchar [not null]
  rating float
  review_count int
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table meal_items {
  meal_item_id bigint [pk, increment]
  restaurant_id int [not null]
  item_name varchar [not null]
  description varchar
  unit_price int [not null]
  image_url varchar
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table meal_group_purchases {
  meal_group_purchase_id bigint [pk, increment]
  creator_user_id bigint [not null, note: 'users.id (bigint)와 타입 일치시킴']
  restaurant_id int [not null]
  title varchar [not null]
  content varchar
  min_order_amount int
  current_amount int [not null]
  current_members int [not null]
  start_at timestamp [not null]
  end_at timestamp [not null]
  status varchar [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  pickup_time timestamp
  recipient_name varchar [not null]
  recipient_phone_number varchar [not null]
  delivery_address varchar [not null]
  delivery_request varchar
}

Table meal_group_purchase_items {
  meal_group_menu_id bigint [pk, increment]
  meal_items_id int [not null]
  meal_group_purchase_id int [not null]
  user_id bigint [not null, note: 'users.id (bigint)와 타입 일치시킴']
  participated_at timestamp [not null]
}

Table meal_group_purchase_participants {
  participation_id bigint [pk, increment]
  meal_group_purchase_id int [not null]
  user_id bigint [not null, note: 'users.id (bigint)와 타입 일치시킴']
  total_order_amount int [not null]
  participated_at timestamp [not null]
  status varchar [not null]
}


// -----------
// --- 관계 ---
// -----------

Ref: restaurants.restaurant_id < meal_items.restaurant_id
Ref: restaurants.restaurant_id < meal_group_purchases.restaurant_id
Ref: users.id < meal_group_purchases.creator_user_id

Ref: meal_group_purchases.meal_group_purchase_id < meal_group_purchase_items.meal_group_purchase_id
Ref: meal_items.meal_item_id < meal_group_purchase_items.meal_items_id
Ref: users.id < meal_group_purchase_items.user_id

Ref: meal_group_purchases.meal_group_purchase_id < meal_group_purchase_participants.meal_group_purchase_id
Ref: users.id < meal_group_purchase_participants.user_id